{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "envelope.schema.json",
  "title": "TEI Context Envelope",
  "description": "The Assurance Layer's context contract (TEI-0): everything an execution consumes, with provenance, policy, and honesty fields first-class. Grounded in RSCH-1/2/3; phases TEI-1+ consume this shape.",
  "type": "object",
  "required": [
    "source_manifest",
    "claims",
    "contradictions",
    "missing_information",
    "applicable_policies",
    "permitted_recipients",
    "expiration",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "source_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "retrieved_at",
          "classification"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "description": "ISO 8601"
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "restricted"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_paths",
          "evidence_class"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "E",
              "I",
              "S"
            ]
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_a",
          "claim_b",
          "surface"
        ]
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "UNKNOWN doctrine: blanks are listed, never filled by guess"
    },
    "applicable_policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permitted_recipients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "distribution is delegated to a filter, never judged ad hoc (R-SEC-1 0.2d lineage)"
    },
    "expiration": {
      "type": "string",
      "description": "when this envelope lapses and must be re-established"
    },
    "provenance": {
      "type": "object",
      "required": [
        "assembled_at",
        "assembled_by",
        "method"
      ],
      "properties": {
        "assembled_at": {
          "type": "string"
        },
        "assembled_by": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      }
    }
  }
}
