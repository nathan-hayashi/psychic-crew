{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Per-dispatch subagent context cost, phase-labelled. Data is the tracked snapshot beside this file, regenerated by scripts/measure-dispatch-cost.sh from the gitignored measurement log \u2014 the spec never points at gitignored data, because a chart that plots nothing from a fresh clone is not a reproducible artifact.",
  "title": {
    "text": "Dispatch cost distribution by role",
    "subtitle": "subagent CONTEXT totals, not output produced; orchestrator tokens excluded, so every value is a lower bound"
  },
  "data": {
    "url": "metrics-snapshot.json",
    "format": {
      "type": "json"
    }
  },
  "encoding": {
    "y": {
      "field": "role",
      "type": "nominal",
      "sort": "-x",
      "title": "agent role"
    },
    "x": {
      "field": "tokens",
      "type": "quantitative",
      "title": "context total (tokens)"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "tokens",
          "aggregate": "mean",
          "type": "quantitative",
          "title": "context total (tokens)"
        },
        "color": {
          "field": "phase",
          "type": "nominal",
          "title": "phase",
          "scale": {
            "scheme": "tableau10"
          }
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "opacity": 0.9,
        "color": "black"
      },
      "encoding": {
        "tooltip": [
          {
            "field": "task",
            "type": "nominal"
          },
          {
            "field": "phase",
            "type": "nominal"
          },
          {
            "field": "tokens",
            "type": "quantitative"
          },
          {
            "field": "duration_ms",
            "type": "quantitative"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "firebrick",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "tokens",
          "aggregate": "mean",
          "type": "quantitative"
        }
      }
    }
  ]
}
